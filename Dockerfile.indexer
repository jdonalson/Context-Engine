# Dockerized code indexer for Qdrant
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir qdrant-client fastembed watchdog

WORKDIR /work

# Default command shows help; Makefile will override
CMD ["python", "scripts/ingest_code.py", "--help"]

